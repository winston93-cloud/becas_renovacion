# 2026-07-16 - Variables de entorno para renovación de becas (InsForge)
NEXT_PUBLIC_INSFORGE_URL=https://g4ta4bfg.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only: API key de servicio (nunca exponer al navegador)
INSFORGE_URL=https://g4ta4bfg.us-east.insforge.app
INSFORGE_API_KEY=

# 2026-07-16 - Destinatario del correo de renovación
BECAS_EMAIL_TO=sistemas3@winston93.edu.mx
BECAS_EMAIL_REPLY_TO=sistemas3@winston93.edu.mx
# Copia oculta (default desarrollo@)
BECAS_EMAIL_BCC=desarrollo@winston93.edu.mx
# Secreto HMAC para links de descarga de respaldo (NO uses la API key)
BECAS_DOC_LINK_SECRET=cambia-este-secreto-largo-y-aleatorio

# 2026-07-24 - Mismo buzón que correo masivo (servicios_admin / Gmail)
# MAIL_USER = avisos_no-replay@winston93.edu.mx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=avisos_no-replay@winston93.edu.mx
# App password de Gmail del buzón masivo (mismo que MAIL_PASS en servicios_admin)
SMTP_PASS=
SMTP_FROM=avisos_no-replay@winston93.edu.mx
SMTP_FROM_NAME=Instituto Winston Churchill
# Solo alumno de prueba (ALAN PRUEBA / 29904; legados 29901–29903). Reales = correos papás.
BECAS_EMAIL_ACCESO_FAMILIA=isc.escobedo@gmail.com
SMTP_TLS_REJECT=true

# Acceso familiar (HMAC)
ACCESO_TOKEN_SECRET=cambia-este-secreto-largo

# 2026-08-13 - InsForge proyecto Boletas (promedios renovación; hosting MySQL de baja)
# API base: https://<appkey>.us-east.insforge.app (ej. 5u3i4tmc.us-east.insforge.app)
INSFORGE_BOLETAS_URL=
INSFORGE_BOLETAS_API_KEY=
INSFORGE_BOLETAS_PROJECT_ID=4a695124-3af9-4b2e-945a-0df93df222e6

# 2026-07-24 - Control Escolar: hashes bcrypt de las 3 claves (una por nivel)
# Generar con: node -e "require('bcrypt').hash('CLAVE',10).then(console.log)"
ADMIN_TOKEN_SECRET=cambia-secreto-admin-hmac
ADMIN_PIN_HASH_MK=
ADMIN_PIN_HASH_PRI=
ADMIN_PIN_HASH_SEC=